+py::tuple getStereoImages(AvoidbenchBridge& bridge)
+{
+  cv::Mat left_cv, right_cv, depth_cv, disp_cv;
+  bridge.getImages(&left_cv, &right_cv, &depth_cv, &disp_cv);
+  if (left_cv.empty() || right_cv.empty() || depth_cv.empty()) {
+    throw std::runtime_error(
+      "Stereo images are empty. Set camera.perform_sgm=true or call "
+      "getUnityDepthImages() for Unity depth.");
+  }
+  if (left_cv.type() != CV_8UC3 || right_cv.type() != CV_8UC3 ||
+      depth_cv.type() != CV_16UC1) {
+    throw std::runtime_error("Unexpected stereo image OpenCV type.");
+  }
+  return py::make_tuple(
+    cvMatToNumpyCopy<unsigned char>(left_cv, 3),
+    cvMatToNumpyCopy<unsigned char>(right_cv, 3),
+    cvMatToNumpyCopy<unsigned short>(depth_cv, 1));
+}
+
+py::tuple getUnityDepthImages(AvoidbenchBridge& bridge)
+{
+  cv::Mat left_cv, depth_cv;
+  bridge.getImages(&left_cv, &depth_cv);
+  if (left_cv.empty() || depth_cv.empty()) {
+    throw std::runtime_error(
+      "Unity RGB/depth images are empty. Call updateUnity(state) before "
+      "requesting images and ensure camera.perform_sgm=false.");
+  }
+  if (left_cv.type() != CV_8UC3 || depth_cv.type() != CV_32FC1) {
+    throw std::runtime_error("Unexpected Unity RGB/depth OpenCV type.");
+  }
+  return py::make_tuple(
+    cvMatToNumpyCopy<unsigned char>(left_cv, 3),
+    cvMatToNumpyCopy<float>(depth_cv, 1));
+}
+
+struct PyQuadStateEstimate
+{
+  std::array<double, 3> position{{0.0, 0.0, 0.0}};
+  std::array<double, 4> orientation{{0.0, 0.0, 0.0, 1.0}};
+  std::array<double, 3> velocity{{0.0, 0.0, 0.0}};
+  double timestamp{0.0};
+};
+
+using DoubleArray =
+  py::array_t<double, py::array::c_style | py::array::forcecast>;
+
+template <std::size_t Size>
+std::array<double, Size> copyStateArray(
+  const DoubleArray& input, const char* name)
+{
+  if (input.ndim() != 1 || input.shape(0) != static_cast<py::ssize_t>(Size)) {
+    throw std::invalid_argument(
+      std::string(name) + " must be a one-dimensional array of length " +
+      std::to_string(Size) + ".");
+  }
+  const py::buffer_info buffer = input.request();
+  const auto* data = static_cast<const double*>(buffer.ptr);
+  std::array<double, Size> output{};
+  std::copy(data, data + Size, output.begin());
+  return output;
+}
+
+void setStateEstimate(
+  PyQuadStateEstimate& state,
+  const DoubleArray& position,
+  const DoubleArray& orientation,
+  const DoubleArray& velocity,
+  const double timestamp)
+{
+  state.position = copyStateArray<3>(position, "position");
+  state.orientation = copyStateArray<4>(orientation, "orientation");
+  state.velocity = copyStateArray<3>(velocity, "velocity");
+  state.timestamp = timestamp;
+}
+
+void populateNativeState(
+  const PyQuadStateEstimate& source, QuadStateEstimate& destination)
+{
+  destination.position =
+    Eigen::Vector3d(source.position[0], source.position[1], source.position[2]);
+  destination.velocity =
+    Eigen::Vector3d(source.velocity[0], source.velocity[1], source.velocity[2]);
+  destination.orientation = Eigen::Quaterniond(
+    source.orientation[3],
+    source.orientation[0],
+    source.orientation[1],
+    source.orientation[2]);
+  destination.timestamp = ros::Time(source.timestamp);
+  destination.coordinate_frame = QuadStateEstimate::CoordinateFrame::WORLD;
+}
+
+bool updateUnity(
+  AvoidbenchBridge& bridge, const PyQuadStateEstimate& python_state)
+{
+  QuadStateEstimate native_state;
+  populateNativeState(python_state, native_state);
+  return bridge.updateUnity(native_state);
+}
+
+void transformVelocityToWorldFrame(PyQuadStateEstimate& python_state)
+{
+  QuadStateEstimate native_state;
+  populateNativeState(python_state, native_state);
+  native_state.transformVelocityToWorldFrame();
+  python_state.velocity = {{
+    native_state.velocity.x(),
+    native_state.velocity.y(),
+    native_state.velocity.z()}};
 }

